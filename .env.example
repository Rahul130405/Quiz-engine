# ==============================================================================
# QuizEngine - Environment Variable Configuration Template
# DO NOT store real production secrets in this file. Copy to .env and configure.
# ==============================================================================

# Node.js Server Port (Default: 5001 local / 5000 Docker)
PORT=5001

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/quizengine

# JWT Authentication Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET=your_authoritative_jwt_secret_min_32_chars_long

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Internal Inter-Service HMAC Authentication Secret (Java-to-Node persistence)
INTERNAL_SERVICE_SECRET=your_dedicated_internal_service_secret_min_32_chars

# Admin Registration Protection Secret
ADMIN_REGISTRATION_SECRET=your_admin_registration_passphrase_secret

# Runtime Environment (development | test | production)
NODE_ENV=development

# Java Backend Embedded Tomcat Port (Default: 8088)
JAVA_PORT=8088

# Java Inter-Service Target Node API URL
NODE_API_URL=http://localhost:5001/api
NODE_AUTH_URL=http://localhost:5001/api/auth/login

# XML Datastore Directories
QUIZ_DATA_DIR=../java-backend/data
WEBAPP_DIR=../java-backend/src/main/webapp
