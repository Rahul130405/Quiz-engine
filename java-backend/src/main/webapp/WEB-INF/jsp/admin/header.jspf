<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<div class="app-container">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-icon">⚡</div>
            <div>
                <div class="brand-title">QuizEngine</div>
                <span class="brand-badge">ADMIN PORTAL</span>
            </div>
        </div>

        <ul class="nav-menu">
            <li class="nav-item ${activeNav == 'dashboard' ? 'active' : ''}">
                <a href="${pageContext.request.contextPath}/admin/dashboard">
                    <span>📊</span> Dashboard
                </a>
            </li>
            <li class="nav-item ${activeNav == 'questions' ? 'active' : ''}">
                <a href="${pageContext.request.contextPath}/admin/questions">
                    <span>❓</span> Question Bank
                </a>
            </li>
            <li class="nav-item ${activeNav == 'create-question' ? 'active' : ''}">
                <a href="${pageContext.request.contextPath}/admin/questions/create">
                    <span>➕</span> Add Question
                </a>
            </li>
            <li class="nav-item ${activeNav == 'topics' ? 'active' : ''}">
                <a href="${pageContext.request.contextPath}/admin/topics">
                    <span>📚</span> Topics &amp; Graph
                </a>
            </li>
            <li class="nav-item">
                <a href="${pageContext.request.contextPath}/api/java/health" target="_blank">
                    <span>🩺</span> System Health ↗
                </a>
            </li>
        </ul>

        <div class="sidebar-footer">
            <div class="user-info">
                <div>Signed in as:</div>
                <div class="user-email">${sessionScope.adminUser}</div>
            </div>
            <form method="POST" action="${pageContext.request.contextPath}/admin/logout" style="margin:0;">
                <button type="submit" class="btn btn-secondary btn-sm" style="width:100%; border-color:#334155; color:#cbd5e1; background:#1e293b;">
                    🚪 Sign Out
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content Body -->
    <div class="main-wrapper">
        <header class="top-bar">
            <div class="page-title">${pageTitle}</div>
            <div style="display:flex; gap:0.75rem; align-items:center;">
                <span class="badge badge-healthy" style="padding:0.4rem 0.75rem;">● XML Datastore Online</span>
                <a href="${pageContext.request.contextPath}/admin/questions/create" class="btn btn-primary btn-sm">
                    ➕ New Question
                </a>
            </div>
        </header>
        <main class="content-body">
