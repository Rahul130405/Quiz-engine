# ==============================================================================
# QuizEngine Backend - Environment Variable Configuration Template
# DO NOT store real production secrets in this file. Copy to .env and configure.
# ==============================================================================

PORT=5001
MONGODB_URI=mongodb://localhost:27017/quizengine
JWT_SECRET=your_authoritative_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=7d
INTERNAL_SERVICE_SECRET=your_dedicated_internal_service_secret_min_32_chars
ADMIN_REGISTRATION_SECRET=your_admin_registration_passphrase_secret
NODE_ENV=development
